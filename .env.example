# ═══ Discord Bot ══════════════════════════════════════════════════════════════
DISCORD_TOKEN=your_bot_token_here

# ═══ Supabase ═════════════════════════════════════════════════════════════════
# Get these from: https://supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here

# ═══ Webhook Server ═══════════════════════════════════════════════════════════
# PORT is set automatically by Railway/Render. Override manually if needed.
WEBHOOK_PORT=3000
# Set this to your public URL (ngrok, Railway domain, etc.)
WEBHOOK_BASE_URL=http://YOUR_IP:3000

# ═══ Dashboard Authentication ═════════════════════════════════════════════════
# Required to log in to the web dashboard at /dashboard
# Use a strong random password. Generate one: openssl rand -base64 32
DASHBOARD_SECRET=change_me_to_a_strong_password

# ═══ WhatsApp (optional) ══════════════════════════════════════════════════════
# Set to 'true' to enable WhatsApp notifications via Baileys
WHATSAPP_ENABLED=false
# Path for WhatsApp session storage (must be a persistent volume on cloud)
WHATSAPP_SESSION_PATH=./wa_session

# ═══ Rate Limiting (per IP) ═══════════════════════════════════════════════════
WEBHOOK_RATE_LIMIT=30
HEALTH_RATE_LIMIT=60
