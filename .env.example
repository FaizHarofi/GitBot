# ═══ Discord Bot ═══
DISCORD_TOKEN=your_bot_token_here

# ═══ Supabase ═══
# Get these from: https://supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here

# ═══ Webhook Server ═══
WEBHOOK_PORT=3000
# Set this to your public URL (e.g., ngrok URL or domain)
# Leave blank to auto-detect local IP
WEBHOOK_BASE_URL=http://YOUR_IP:3000

# ═══ Rate Limiting (per IP) ═══
WEBHOOK_RATE_LIMIT=30
HEALTH_RATE_LIMIT=60
